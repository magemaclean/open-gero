{
  "name": "OpenGero",
  "install": "bash .cursor/install.sh",
  "terminals": [
    {
      "name": "api",
      "command": "DATABASE_URL=sqlite:///./opengero.db SECRET_KEY=dev-secret PYTHONPATH=apps/api .venv/bin/uvicorn opengero.main:app --host 0.0.0.0 --port 8000 --reload"
    },
    {
      "name": "web",
      "command": "cd apps/web && npm run dev -- --host 0.0.0.0 --port 5173"
    }
  ],
  "ports": [
    { "name": "api", "port": 8000 },
    { "name": "web", "port": 5173 }
  ]
}
